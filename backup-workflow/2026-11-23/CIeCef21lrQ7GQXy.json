  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "// Messaggio di conferma per il team, con i dati letti da Meta.\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst dati = $('Dati del cliente').first().json;\nconst pagina = $('Account Instagram della Pagina').first().json;\nconst profilo = $('Profilo Instagram').first().json;\nconst luogo = $('Valuta luogo').first().json;\nconst rigaLuogo = {\n  scritto: `Luogo: la Pagina ha l'indirizzo${luogo.indirizzo ? ` (${esc(luogo.indirizzo)})` : ''}, ho scritto id_luogo ✔`,\n  gia_presente: `Luogo: id_luogo era già compilato (${esc(luogo.id_luogo_attuale)}), l'ho lasciato com'è`,\n  senza_indirizzo: \"⚠️ Luogo: la Pagina non ha l'indirizzo: aggiungilo su Facebook per poter mettere il luogo\",\n  colonna_mancante: '⚠️ Luogo: nella scheda Clienti manca la colonna id_luogo: aggiungila in fondo e rilancia questo flusso',\n}[luogo.esito_luogo] || 'Luogo: non controllato';\nconst testo = [\n  `✅ <b>Negozio collegato: ${esc(dati.cliente)}</b>`,\n  `Pagina Facebook: ${esc(pagina.name)} (id ${esc(dati.fb_page_id)})`,\n  `Instagram: @${esc(profilo.username)} (id ${esc(pagina.instagram_business_account.id)})`,\n  'Commenti: iscrizione non fatta (nodo spento: la serie retail non ha ancora il flusso commenti)',\n  rigaLuogo,\n  'Ho scritto ig_user_id e fb_page_id nella scheda Clienti.',\n  'Prossimo passo: metti attivo = si e fai una prova con una storia.',\n].join('\\n');\nreturn [{ json: { testo } }];\n"
   },
