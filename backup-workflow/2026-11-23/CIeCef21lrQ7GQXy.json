   "id": "985e6d09-e4f4-5da6-b0b1-3f9f1b734c21",
   "name": "Iscrivi ai commenti",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.4,
   "position": [
    2400,
    40
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 5000,
   "notes": "Iscrive l'app dell'agenzia agli eventi «feed» della Pagina: serve per ricevere i commenti (Facebook e, tramite la Pagina, Instagram).",
   "notesInFlow": false,
   "disabled": true
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "// Decide cosa scrivere in id_luogo nella scheda Clienti.\n// Instagram e Facebook accettano come «luogo» solo una Pagina che ha un indirizzo: di solito la Pagina del cliente stesso.\n// Se id_luogo è già compilato (magari a mano, con un'altra Pagina) non lo tocchiamo.\nconst pagina = $('Account Instagram della Pagina').first().json;\nconst cliente = $('Cerca cliente').first().json;\nconst idPagina = String($('Dati del cliente').first().json.fb_page_id).trim();\nconst loc = pagina.location || {};\nconst haIndirizzo = Boolean(loc.street || loc.city || (loc.latitude !== undefined && loc.longitude !== undefined));\nconst attuale = cliente.id_luogo;\nconst attualeTesto = String(attuale ?? '').trim();\n\nlet esito = 'senza_indirizzo';\nlet idLuogo = attuale ?? '';\n// La lettura filtrata di Google Sheets restituisce tutte le colonne dell'intestazione: se id_luogo\n// non c'è proprio, la colonna manca nel foglio (e Sheets ignorerebbe il valore senza dire niente).\nif (!('id_luogo' in cliente)) esito = 'colonna_mancante';\nelse if (attualeTesto) esito = 'gia_presente';\nelse if (haIndirizzo) {\n  esito = 'scritto';\n  idLuogo = idPagina;\n}\nreturn [{\n  json: {\n    id_luogo: idLuogo,\n    esito_luogo: esito,\n    id_luogo_attuale: attualeTesto,\n    indirizzo: [loc.street, loc.city].filter(Boolean).join(', '),\n  },\n}];\n"
   },
   "id": "ae68ce7e-2667-5134-a621-2f11491abab3",
   "name": "Valuta luogo",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2640,
    40
   ],
   "notes": "La Pagina ha un indirizzo? Allora può fare da «luogo» per Instagram e Facebook: scrive id_luogo = ID della Pagina (se id_luogo è vuoto).",
   "notesInFlow": true
  },
